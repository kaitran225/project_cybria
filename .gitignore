# --- Obsidian vault ---
# Volatile UI state (changes on every tab/window move — causes merge noise)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/graph.json

.vault/**/.obsidian/workspace.json
.vault/**/.obsidian/workspace-mobile.json
.vault/**/.obsidian/cache/
.vault/**/.obsidian/graph.json
.vault/**/.obsidian/plugins/*/data.json

# Built plugin output (run npm run build in vault plugin folder)
.vault/**/.obsidian/plugins/obsidian-style-settings/main.js

# Deleted notes
.trash/

# Plugin-local caches and indexes (often large / machine-specific)
.obsidian/plugins/*/data.json
.obsidian/plugins/obsidian-git/
.obsidian/plugins/obsidian-excalidraw-plugin/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# --- Editor ---
.idea/
.vscode/*
!.vscode/extensions.json

# --- Env / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# --- Logs / temp ---
*.log
logs/
tmp/
temp/
.cache/
*.bak
*.tmp

# --- Node (Obsidian plugins, tooling) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
build/
out/
.vite/
.parcel-cache/
coverage/
*.tsbuildinfo

# --- Python (.prototype) ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg

# --- Archives (local dumps) ---
*.zip
*.7z
*.tar
*.tar.gz
*.rar
